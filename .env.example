# Токен бота MAX (платформа / «MAX для бизнеса» → Получить токен)
BOT_TOKEN=

# Приём фото на сервере optical
PHOTO_INBOX_URL=http://base.401010.ru/api/photo-inbox
PHOTO_INBOX_TOKEN=

# Ограничить чаты (пусто = все). Узнать id: напишите боту /chatid
ALLOWED_CHAT_IDS=

# Ответ текстом при успехе (у MAX нет реакций как в Telegram-боте)
REPLY_ON_SUCCESS=1
SHOW_IDS_IN_REPLY=0

HTTP_TIMEOUT_SEC=60
POLL_TIMEOUT_SEC=30
POLL_LIMIT=100

# Обычно не менять
# MAX_API_BASE=https://platform-api2.max.ru
